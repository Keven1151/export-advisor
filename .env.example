# 到 https://comtradeplus.un.org/ 免費註冊帳號後，在 API Management 申請 subscription key
COMTRADE_API_KEY=your_key_here

# 到 https://apiportal.wto.org/ 免費註冊帳號，Products > Standard 訂閱後取得 subscription key
# 用途：台灣（Chinese Taipei）官方自行申報的貿易總額，比Comtrade的鏡射估計值準，
# 但只有「全球總額」沒有國別拆分，見 data/wto_client.py 說明
WTO_API_KEY=your_key_here
